# Local development only. Replace both password placeholders with the same value.
DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://inventory:replace-with-a-long-random-password@localhost:5433/inventory
# Use a different long URL-safe random password for the least-privilege web-app login.
APP_DATABASE_URL=postgresql://inventory_runtime:replace-with-a-different-long-random-password@localhost:5433/inventory
# Leave unset for loopback development. Enable only behind a proxy that sanitizes X-Forwarded-For.
# AUTH_TRUST_PROXY_HEADERS=true
