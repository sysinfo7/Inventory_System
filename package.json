{
  "name": "inventory-system",
  "version": "1.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "db:check": "node --env-file-if-exists=.env scripts/db.mjs check",
    "db:provision-app": "node --env-file-if-exists=.env scripts/provision-app-role.mjs",
    "db:verify-demo-seed": "node --env-file-if-exists=.env scripts/verify-demo-seed.mjs",
    "db:prepare:neon-demo": "node --env-file=.env.neon-demo scripts/prepare-neon-demo.mjs",
    "db:verify-stock": "node --env-file-if-exists=.env scripts/verify-stock-workflow.mjs",
    "db:verify-stock-concurrency": "node --env-file-if-exists=.env scripts/verify-stock-concurrency.mjs",
    "purchasing:verify": "node --env-file-if-exists=.env scripts/verify-purchasing-workflow.mjs",
    "purchasing:verify-concurrency": "node --env-file-if-exists=.env scripts/verify-purchasing-concurrency.mjs",
    "auth:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-admin.mjs",
    "auth:reset-admin-local": "node --env-file-if-exists=.env scripts/reset-local-admin.mjs",
    "auth:seed-test-users": "node --env-file-if-exists=.env scripts/seed-permission-test-users.mjs",
    "auth:cleanup-checks": "node --env-file-if-exists=.env scripts/cleanup-auth-check-users.mjs",
    "auth:verify": "node --env-file-if-exists=.env scripts/verify-auth-workflow.mjs",
    "public-demo:verify": "node scripts/verify-public-demo.mjs"
  },
  "dependencies": {
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
